# M-Pesa Daraja API Credentials (from https://developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox

# Callback URL (use ngrok in dev, your domain in prod)
CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# Firebase
FIREBASE_PROJECT_ID=fc-tournaments-bc93a
FIREBASE_PRIVATE_KEY="your_private_key"
FIREBASE_CLIENT_EMAIL=your_client_email

# Server
PORT=3000
