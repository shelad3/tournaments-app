rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuth() && userDocExists()
        && getUserRole() in ['admin', 'superAdmin', 'subAdmin'];
    }

    function isSuperAdmin() {
      return isAuth() && userDocExists()
        && getUserRole() == 'superAdmin';
    }

    // ===== USERS =====
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // ===== TOURNAMENTS =====
    match /tournaments/{tournamentId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();

      match /matches/{matchId} {
        allow read: if isAuth();
        allow create: if isAdmin();
        allow update: if isAuth();
        allow delete: if isAdmin();
      }
    }

    // ===== PARTICIPATIONS =====
    match /participations/{partId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin() || isOwner(resource.data.userId);
      allow delete: if isAdmin() || (isOwner(resource.data.userId) && resource.data.accepted != true);
    }

    // ===== WALLETS =====
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ===== TRANSACTIONS =====
    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ===== MESSAGES (Announcements) =====
    match /messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===== PLACES =====
    match /places/{placeId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ===== FOLLOWS =====
    match /follows/{followId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth();
    }

    // ===== TOURNAMENT CHAT =====
    match /tournament_chats/{tournamentId}/messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // ===== NOTIFICATIONS =====
    match /notifications/{userId}/items/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===== FORUM CHANNELS =====
    match /forum_channels/{channelId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isOwner(resource.data.userId) || isAdmin();
        allow delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    // ===== WAITING LIST =====
    match /waiting_list/{entryId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
    }

    // ===== LEAGUE UPDATES =====
    match /league_updates/{updateId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ===== SUPER WALLET =====
    match /admin/{docId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ===== FCM TOKENS =====
    match /fcm_tokens/{tokenId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow delete: if isAuth();
    }

    // ===== REFERRALS =====
    match /referrals/{referralId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
