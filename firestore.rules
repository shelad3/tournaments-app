rules_version = '2';

// Helper: check if the requester is authenticated
function isAuth() {
  return request.auth != null;
}

// Helper: check if the requester is the document owner
function isOwner(userId) {
  return request.auth != null && request.auth.uid == userId;
}

// Helper: check if user has admin role (any admin tier)
function isAdmin() {
  return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superAdmin', 'subAdmin'];
}

// Helper: check if user is super admin only
function isSuperAdmin() {
  return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin';
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== USERS =====
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // ===== TOURNAMENTS =====
    match /tournaments/{tournamentId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ===== PARTICIPATIONS (top-level collection) =====
    match /participations/{partId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===== MATCHES (for brackets) =====
    match /matches/{matchId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ===== WALLETS =====
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ===== TRANSACTIONS =====
    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ===== MESSAGES (Admin Announcements) =====
    match /messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===== FORUM MESSAGES =====
    match /forum_messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ===== PLACES (gaming venues) =====
    match /places/{placeId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ===== FOLLOWS =====
    match /follows/{followId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth();
    }

    // ===== CHAT MESSAGES (tournament chats) =====
    match /tournaments/{tournamentId}/chat/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // ===== LEAGUE UPDATES =====
    match /league_updates/{updateId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ===== SUPER WALLET =====
    match /admin/{docId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ===== FCM TOKENS =====
    match /fcm_tokens/{tokenId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow delete: if isAuth();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
