rules_version = '2';

// Helper: check if the requester is authenticated
function isAuth() {
  return request.auth != null;
}

// Helper: check if the requester is the document owner
function isOwner(userId) {
  return request.auth != null && request.auth.uid == userId;
}

// Helper: check if user has admin role (any admin tier)
function isAdmin() {
  return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superAdmin', 'subAdmin'];
}

// Helper: check if user is super admin only
function isSuperAdmin() {
  return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin';
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== USERS =====
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // ===== TOURNAMENTS =====
    match /tournaments/{tournamentId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();

      // ===== MATCHES (brackets subcollection) =====
      // Update allowed for any auth user so participants can report results,
      // propose times, and auto-advance winners to next round.
      // Create/delete remain admin-only.
      match /matches/{matchId} {
        allow read: if isAuth();
        allow create: if isAdmin();
        allow update: if isAuth();
        allow delete: if isAdmin();
      }
    }

    // ===== PARTICIPATIONS =====
    match /participations/{partId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin() || isOwner(resource.data.userId);
      allow delete: if isAdmin() || (isOwner(resource.data.userId) && resource.data.accepted != true);
    }

    // ===== WALLETS =====
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ===== TRANSACTIONS =====
    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ===== MESSAGES (Admin Announcements) =====
    match /messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===== PLACES (gaming venues) =====
    match /places/{placeId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ===== FOLLOWS =====
    match /follows/{followId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth();
    }

    // ===== TOURNAMENT CHAT =====
    match /tournament_chats/{tournamentId}/messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // ===== NOTIFICATIONS =====
    match /notifications/{userId}/items/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===== FORUM CHANNELS =====
    match /forum_channels/{channelId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // ===== FORUM MESSAGES (subcollection) =====
      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isOwner(resource.data.userId) || isAdmin();
        allow delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    // ===== WAITING LIST =====
    match /waiting_list/{entryId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
    }

    // ===== LEAGUE UPDATES =====
    match /league_updates/{updateId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ===== SUPER WALLET =====
    match /admin/{docId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ===== FCM TOKENS =====
    match /fcm_tokens/{tokenId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow delete: if isAuth();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
